# Адрес Laravel-API для dev-сервера Vite (прокси /api).
# Если Laravel запущен через `php artisan serve`:
VITE_PROXY_TARGET=http://127.0.0.1:8000
# Если Laravel открыт через OSPanel, раскомментируйте и укажите домен:
# VITE_PROXY_TARGET=http://softy.local

# Порт dev-сервера React
VITE_DEV_PORT=5173

# Явный адрес API (нужен только если frontend и backend на разных доменах).
# Оставьте пустым для работы через относительный путь /api.
VITE_API_URL=
