APP_NAME=Softy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Yekaterinburg
APP_URL=http://softy.local

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- MySQL ---
# Для OSPanel: DB_HOST=localhost (или 127.0.0.1), DB_USERNAME=root, DB_PASSWORD= (пусто по умолчанию)
# На VPS создайте отдельного пользователя и укажите его данные.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=softy
DB_USERNAME=softy
DB_PASSWORD=softy

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@softy.local"
MAIL_FROM_NAME="${APP_NAME}"

# Домены, которым разрешено обращаться к API (CORS).
CORS_ALLOWED_ORIGINS=http://softy.local,http://localhost:5173,http://127.0.0.1:5173

# Демо-данные (используются сидерами).
SOFTY_ADMIN_EMAIL=admin@softy.local
SOFTY_ADMIN_PASSWORD=password
SOFTY_DEMO_EMAIL=buyer@softy.local
SOFTY_DEMO_PASSWORD=password

VITE_APP_NAME="${APP_NAME}"
