APP_NAME=Softy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Yekaterinburg
APP_URL=http://ВАШ_IP_ИЛИ_ДОМЕН

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- MySQL: данные из панели VPS ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=softy
DB_USERNAME=softy
DB_PASSWORD=ПАРОЛЬ_ИЗ_ПАНЕЛИ

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@softy.ru"
MAIL_FROM_NAME="${APP_NAME}"

# Домены, которым разрешено обращаться к API.
CORS_ALLOWED_ORIGINS=http://ВАШ_IP_ИЛИ_ДОМЕН

VITE_APP_NAME="${APP_NAME}"
